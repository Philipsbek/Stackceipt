# Stackceipt environment configuration
# Copy to .env.local and fill in. NEVER commit real secrets — only this example file.

# ── Supabase (client-safe) ─────────────────────────────────────────
# From the Supabase dashboard: Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The anon/publishable key is safe to expose to the browser (RLS protects data).
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# ── Application ─────────────────────────────────────────────────────
# Used for building absolute callback/redirect URLs. No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Web Push (PWA notifications) ────────────────────────────────────
# Generate a keypair once with:  npx web-push generate-vapid-keys
# Public key is browser-safe; private key is server-only. Set BOTH in Vercel.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=YOUR-VAPID-PUBLIC-KEY
VAPID_PRIVATE_KEY=YOUR-VAPID-PRIVATE-KEY
# Contact URI advertised to push services (mailto: or https:).
VAPID_SUBJECT=mailto:you@example.com

# ── Server-only (NEVER prefix with NEXT_PUBLIC) ─────────────────────
# Service role key: required by the dev seed script AND for push delivery +
# the renewal cron (server reads every recipient's push subscription, bypassing
# RLS). Keep it out of the browser bundle. Leave blank to disable push sending.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
# Some tooling reads SUPABASE_URL (non-public) too; mirror the project URL here.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# ── Daily cron (renewal reminders + janitor) ────────────────────────
# A shared secret the Vercel Cron request must present. Leave unset to disable.
CRON_SECRET=
