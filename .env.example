# Stackceipt environment configuration
# Copy to .env.local and fill in. NEVER commit real secrets — only this example file.

# ── Supabase (client-safe) ─────────────────────────────────────────
# From the Supabase dashboard: Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The anon/publishable key is safe to expose to the browser (RLS protects data).
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# ── Application ─────────────────────────────────────────────────────
# Used for building absolute callback/redirect URLs. No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Server-only (NEVER prefix with NEXT_PUBLIC) ─────────────────────
# Service role key is required ONLY by the dev seed script (scripts/seed.ts).
# Do not use it in application runtime code. Keep it out of the browser bundle.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
# Some tooling reads SUPABASE_URL (non-public) too; mirror the project URL here for the seed.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# ── Optional: Janitor daily cron (only if the cron endpoint is enabled) ──
# A shared secret the Vercel Cron request must present. Leave unset to disable the cron.
CRON_SECRET=
